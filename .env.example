# Per-service identity (also used as `application` field in log records)
# Each service overrides APP_MCP_NAME via its config class default.
APP_GIT_COMMIT=local

# MCP transport
APP_MCP_TRANSPORT=streamable-http   # stdio | sse | streamable-http
APP_MCP_HOST=0.0.0.0
APP_MCP_PORT=8000
APP_MCP_STATELESS_HTTP=true

# Auth — disabled by default. Set both to enable bearer-token auth on the /mcp endpoint.
APP_MCP_AUTH_ENABLED=false
APP_MCP_AUTH_API_KEY=

# Healthz endpoints (different port than the MCP server)
APP_HEALTHZ_LISTEN_HOST=0.0.0.0
APP_HEALTHZ_PORT=8080

# Logging
APP_COLORIZE_LOGS=true
APP_JSON_FORMAT_LOGS=true            # JSON logs go to stdout in addition to Logstash

# Logstash → Kibana (test/dev cluster values; override per environment)
APP_LOGSTASH_ENABLED=true
APP_LOGSTASH_HOST=10.4.0.6
APP_LOGSTASH_PORT=5959
APP_LOGSTASH_DATABASE_PATH=logstash_cache.db

# Sentry (disabled by default)
APP_SENTRY_DSN=
APP_SENTRY_ENVIRONMENT=

# Prometheus metrics scraping (disable in tests/CI)
APP_COLLECT_METRICS=true
