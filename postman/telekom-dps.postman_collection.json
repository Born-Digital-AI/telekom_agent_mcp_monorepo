    {
      "name": "End-to-end flows",
      "description": "Composed multi-request flows that mirror the live `identifikacia_*` tools.",
      "item": [
        {
          "name": "1. RČ → Party → Customer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/party-management/3.54.0/v2/parties?identificationId={{rodne_cislo}}&identificationType=socialSecurityNumber&fields=*",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "party-management",
                "3.54.0",
                "v2",
                "parties"
              ],
              "query": [
                {
                  "key": "identificationId",
                  "value": "{{rodne_cislo}}"
                },
                {
                  "key": "identificationType",
                  "value": "socialSecurityNumber"
                },
                {
                  "key": "fields",
                  "value": "*"
                }
              ]
            },
            "description": "Step 1 of the RČ→Customer flow. Captures the first PARTY_id into `{{party_id}}` for the next step.\n\nSet the next request to **Search customers by engagedParty.id** to complete the chain."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Capture the first party_id into the environment for the next request.",
                  "pm.test('returned at least one party', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    const arr = pm.response.json();",
                  "    pm.expect(arr).to.be.an('array').that.is.not.empty;",
                  "    pm.environment.set('party_id', arr[0].id);",
                  "    console.log('captured party_id =', arr[0].id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. MSISDN → Product → Customer.id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/product-inventory/4.64/products?query=publicIdentifier=={{msisdn}}&fields=*&size=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "product-inventory",
                "4.64",
                "products"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "publicIdentifier=={{msisdn}}"
                },
                {
                  "key": "fields",
                  "value": "*"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "Step 1 of the MSISDN→Customer flow. Captures the first `accounts[type=customer].id` into `{{customer_id}}` for the next step.\n\nSet the next request to **Get customer by id** to complete the chain."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Capture the first customer account id into the environment.",
                  "pm.test('returned at least one product with a customer account', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    const products = pm.response.json();",
                  "    pm.expect(products).to.be.an('array').that.is.not.empty;",
                  "    for (const p of products) {",
                  "        for (const a of (p.accounts || [])) {",
                  "            if (a.accountType === 'customer' && a.id) {",
                  "                pm.environment.set('customer_id', a.id);",
                  "                console.log('captured customer_id =', a.id);",
                  "                return;",
                  "            }",
                  "        }",
                  "    }",
                  "    pm.expect.fail('no customer-typed account on any product');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Customer id → active agreements (over_viazanost flow)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/product-inventory/4.64/products?query=eq(customer.id,{{customer_id}})&fields=*&size=200&page=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "product-inventory",
                "4.64",
                "products"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "eq(customer.id,{{customer_id}})"
                },
                {
                  "key": "fields",
                  "value": "*"
                },
                {
                  "key": "size",
                  "value": "200"
                },
                {
                  "key": "page",
                  "value": "0"
                }
              ]
            },
            "description": "Mirrors the PI call made by the `over_viazanost` MCP tool.\n\nThe test script filters products client-side using the same active-status set and date-window logic, then classifies the result into Nema_viazanost / Prolongacne_okno / Viazanost_do_roka / Viazanost_viac_ako_rok — identical to `_classify_viazanost()` in tools.py.\n\nRequires `customer_id` in the environment (run the RCO flow first, or set it manually)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ACTIVE_STATUSES = new Set([",
                  "    'active','inProtectionPeriod','validated','signed',",
                  "    'approved','inProcess','inCorrection','initialized','approvalPending'",
                  "]);",
                  "",
                  "function parseDate(s) {",
                  "    if (!s) return null;",
                  "    const d = new Date(s.replace('Z', '+00:00'));",
                  "    return isNaN(d.getTime()) ? null : d;",
                  "}",
                  "",
                  "pm.test('response is 200 array', function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "",
                  "const products = pm.response.json();",
                  "const today = new Date(); today.setHours(0,0,0,0);",
                  "",
                  "const active = [];",
                  "for (const p of products) {",
                  "    const agreements = (p.agreements || []).filter(a => {",
                  "        const status = (a.status || '').toLowerCase();",
                  "        if (status && !ACTIVE_STATUSES.has(status)) return false;",
                  "        const period = a.agreementPeriod || {};",
                  "        const from = parseDate(period.startDateTime);",
                  "        const to   = parseDate(period.endDateTime);",
                  "        return from && to && from <= today && today <= to;",
                  "    }).map(a => ({",
                  "        from: a.agreementPeriod.startDateTime.slice(0,10),",
                  "        to:   a.agreementPeriod.endDateTime.slice(0,10)",
                  "    }));",
                  "    if (agreements.length > 0) active.push({ name: p.name, agreements });",
                  "}",
                  "",
                  "let latestTo = null;",
                  "for (const p of active) {",
                  "    for (const a of p.agreements) {",
                  "        const d = new Date(a.to); if (!latestTo || d > latestTo) latestTo = d;",
                  "    }",
                  "}",
                  "",
                  "let typ = 'Nema_viazanost';",
                  "if (latestTo) {",
                  "    const days = Math.floor((latestTo - today) / 86400000);",
                  "    typ = days < 90 ? 'Prolongacne_okno' : (days < 365 ? 'Viazanost_do_roka' : 'Viazanost_viac_ako_rok');",
                  "}",
                  "",
                  "console.log('active products with agreements:', JSON.stringify(active, null, 2));",
                  "console.log('viazanost_typ:', typ);",
                  "pm.environment.set('viazanost_typ', typ);",
                  "",
                  "pm.test('viazanost_typ resolved (not Chyba)', function () {",
                  "    pm.expect(typ).to.not.eql('Chyba');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
