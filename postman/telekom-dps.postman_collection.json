              "path": ["product-inventory", "4.64", "products"],
              "query": [
                { "key": "customer", "value": "{{customer_id}}" },
                { "key": "fields", "value": "*" },
                { "key": "size", "value": "50" }
              ]
            },
            "description": "All products owned by a customer. Filter client-side by `group` (`tariff`, `addon`, `device`, `SIM`, ...) for relevant subsets."
          }
        },
        {
          "name": "Search active tariffs only",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/product-inventory/4.64/products?customer={{customer_id}}&group=tariff&status=Active&fields=*",
