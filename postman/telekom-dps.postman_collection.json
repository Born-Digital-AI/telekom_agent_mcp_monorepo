    {
      "name": "Product Inventory 4.64",
      "description": "`/product-inventory/4.64/products` — only API on this gateway that supports MSISDN lookup. See [`dps-product-inventory-api`](file:///Users/michaljurco/.claude/skills/dps-product-inventory-api/SKILL.md) skill.",
      "item": [
        {
          "name": "Search products by MSISDN (publicIdentifier)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/product-inventory/4.64/products?query=publicIdentifier=={{msisdn}}&fields=*&size=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "product-inventory",
                "4.64",
                "products"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "publicIdentifier=={{msisdn}}"
                },
                {
                  "key": "fields",
                  "value": "*"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "The MSISDN-lookup query. Returns up to 20 products; pick the one with `accounts[].accountType=customer` to pivot into customer-management."
          }
        },
        {
          "name": "Search products by customer",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/product-inventory/4.64/products?customer={{customer_id}}&fields=*&size=50",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "product-inventory",
                "4.64",
                "products"
              ],
              "query": [
                {
                  "key": "customer",
                  "value": "{{customer_id}}"
                },
                {
                  "key": "fields",
                  "value": "*"
                },
                {
                  "key": "size",
                  "value": "50"
                }
              ]
            },
            "description": "All products owned by a customer. Filter client-side by `group` (`tariff`, `addon`, `device`, `SIM`, ...) for relevant subsets."
          }
        },
        {
          "name": "Get products for agreements by MSISDN (RQL eq(name,...))",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/product-inventory/4.64/products?query=eq(name,{{msisdn}})&fields=*&size=200&page=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "product-inventory",
                "4.64",
                "products"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "eq(name,{{msisdn}})"
                },
                {
                  "key": "fields",
                  "value": "*"
                },
                {
                  "key": "size",
                  "value": "200"
                },
                {
                  "key": "page",
                  "value": "0"
                }
              ]
            },
            "description": "RQL function-syntax query used by  and the  tool.\n\nField  in PI = MSISDN (normalized SK intl format, e.g. ). This is **different** from the  FIQL query — use this form when fetching agreement data.\n\nsize=200 and page=0 mirrors the NLP extractor ceiling; if the response contains exactly 200 items the result may be incomplete."
          }
        },
        {
          "name": "Get products for agreements by customer id (RQL eq(customer.id,...))",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/product-inventory/4.64/products?query=eq(customer.id,{{customer_id}})&fields=*&size=200&page=0",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "product-inventory",
                "4.64",
                "products"
              ],
              "query": [
                {
                  "key": "query",
                  "value": "eq(customer.id,{{customer_id}})"
                },
                {
                  "key": "fields",
                  "value": "*"
                },
                {
                  "key": "size",
                  "value": "200"
                },
                {
                  "key": "page",
                  "value": "0"
                }
              ]
            },
            "description": "RQL function-syntax query used by  and the  tool.\n\nPreferred over the MSISDN form when a Customer ID is known — returns all products for the customer (not just the queried SIM), so it correctly covers B2B or multi-SIM scenarios.\n\nFilters for active agreements are applied client-side: status ∈ _ACTIVE_AGREEMENT_STATUSES AND agreementPeriod.startDateTime ≤ today ≤ agreementPeriod.endDateTime."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Count products with at least one agreement entry — sanity check.",
                  "pm.test(\"response is 200 array\", function () {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"warn if result size >= 200 (page ceiling reached)\", function () {",
                  "    const arr = pm.response.json();",
                  "    if (arr.length >= 200) { console.warn(\"Result hit size=200 ceiling — data may be incomplete.\"); }",
                  "    pm.expect(true).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Search active tariffs only",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/product-inventory/4.64/products?customer={{customer_id}}&group=tariff&status=Active&fields=*",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "product-inventory",
                "4.64",
                "products"
              ],
              "query": [
                {
                  "key": "customer",
                  "value": "{{customer_id}}"
                },
                {
                  "key": "group",
                  "value": "tariff"
                },
                {
                  "key": "status",
                  "value": "Active"
                },
                {
                  "key": "fields",
                  "value": "*"
                }
